# ── NSFW Local AI Pipeline (new) ─────────────────────────────────────────────
# DISCORD_TOKEN is the canonical name — TOKEN above is kept as fallback
# DISCORD_TOKEN=

# Comma-separated guild IDs for slash command sync (get from Discord dev portal)
GUILD_IDS=1443960186271305740

# Comma-separated channel IDs to monitor, or "all" to monitor every channel
MONITORED_CHANNELS=all

# Channel ID where BLOCK/REVIEW logs are posted
LOG_CHANNEL_ID=1506930428945371226

# Role ID that can use /nsfw slash commands (optional)
ADMIN_ROLE_ID=1444299979433709712

# Directory to store downloaded AI model files (~1.5 GB total)
MODEL_CACHE_DIR=./models

# Device for inference: "cuda" (GPU) or "cpu"
DEVICE=cuda

# Maximum video file size to process (MB)
MAX_VIDEO_SIZE_MB=50

# Maximum video duration to process (seconds)
MAX_VIDEO_DURATION_SECS=300

# Confidence window above threshold → REVIEW verdict (not BLOCK)
REVIEW_THRESHOLD_OFFSET=0.15
# Channel ID for posting detailed scan logs of ALL checked media (even SAFE ones) for testing
DEBUG_LOG_CHANNEL_ID=1506938404137472072