# .env.example — Copy this to .env and fill in your values
# Never commit .env to version control

# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=               # Your bot token from Discord Developer Portal
TOKEN=                       # Legacy alias (same value, kept for compatibility)
PREFIX=;                     # Command prefix for legacy prefix commands

# ── Guild & Channel Config ────────────────────────────────────────────────────
GUILD_IDS=123456789,987654321        # Comma-separated guild IDs for slash command sync
MONITORED_CHANNELS=                  # Comma-separated channel IDs to monitor, or "all"
LOG_CHANNEL_ID=                      # Channel ID where moderation logs are sent
ADMIN_ROLE_ID=                       # Role ID that can use /nsfw slash commands

# ── AI Model Config ───────────────────────────────────────────────────────────
MODEL_CACHE_DIR=./models             # Directory to store downloaded HuggingFace models
DEVICE=cuda                          # "cuda" for GPU or "cpu" for CPU-only

# ── Video/GIF Limits ─────────────────────────────────────────────────────────
MAX_VIDEO_SIZE_MB=50                 # Maximum video file size to process
MAX_VIDEO_DURATION_SECS=300         # Maximum video duration to process (5 minutes)
REVIEW_THRESHOLD_OFFSET=0.15        # Confidence window above threshold = REVIEW verdict

# ── Database (SQLite — no installation required) ────────────────────────
# The bot creates this file automatically on first run
SQLITE_DB_PATH=./bot.db
